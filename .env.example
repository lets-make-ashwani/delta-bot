# Delta Exchange Scalper Bot Configuration
# Modes:
#   demo  -> Uses https://demo.delta.exchange (via https://testnet-api.delta.exchange)
#   paper -> Real-time local simulation on live market ticks (No API keys needed)
#   live  -> Real money on Delta Exchange India (https://api.india.delta.exchange)
BOT_MODE=demo

# Target Coin Symbol (e.g. XRP, BTC, ETH, SOL)
SYMBOL=XRP

# API Credentials from https://demo.delta.exchange (or Delta India Live)
DELTA_API_KEY=your_demo_api_key_here
DELTA_API_SECRET=your_demo_api_secret_here

# 100x Leverage
LEVERAGE=100

# Capital & Sizing Parameters (0.0 = automatically uses your full demo wallet balance)
INITIAL_CAPITAL_INR=0.0
MARGIN_RATIO_PER_TRADE=0.25
MAX_CONTRACTS_PER_TRADE=50000

# Optional: Groq LPU Quantitative AI Brain (Get free key from https://console.groq.com/keys)
# Ultra-fast LLM quantitative reasoning (500 tokens/sec on Llama 3.3 70B)
GROQ_API_KEY=your_free_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
